{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  // functions/ 是 Cloudflare Pages Functions（线上那一半的服务端）：
  // 它按导出名认端点，因此不引 workers-types，用的就是这里那套 DOM 类型。
  "include": ["src", "functions", "vite.config.ts", "vite-plugin-judge-api.ts"]
}
